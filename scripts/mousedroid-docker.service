# =============================================================================
# MouseDroid — Docker Compose systemd service
# =============================================================================
# Manages the mousedroid container lifecycle via docker compose.
#
# Configuration:
#   Environment variables can be set in /etc/mousedroid/docker.env
#   or overridden via systemd drop-ins.
#
# Install:
#   sudo cp scripts/mousedroid-docker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mousedroid-docker
# =============================================================================

[Unit]
Description=MouseDroid — Docker Container Runtime
Documentation=https://github.com/ianshank/Mouse-Droid-Jetson-Nano
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# Type=exec (NOT notify): ExecStart is `docker compose up`, which never calls
# sd_notify(READY=1) — under Type=notify systemd waits for a readiness message
# that can never arrive and fails the start on timeout. WatchdogSec is likewise
# meaningless without sd_notify; container liveness is owned by the image's
# HEALTHCHECK -> heartbeat-file chain (scripts/mousedroid_healthcheck.sh).
#
# Note the liveness split: docker-compose.jetson.yml sets
# `restart: unless-stopped`, so Docker restarts a crashed container on its own
# and `up --abort-on-container-exit` may never fire. Pre-existing behaviour,
# documented here so the two restart owners aren't mistaken for one.
Type=exec
User=root

# Working directory — override MOUSEDROID_INSTALL_DIR in docker.env to relocate
WorkingDirectory=/opt/mousedroid

# Default environment values (systemd does not support shell ${VAR:-default} syntax;
# use Environment= for defaults so ExecStart* lines can reference bare ${VAR}).
# These are overridden by any matching keys in docker.env or a drop-in unit.
Environment=MOUSEDROID_INSTALL_DIR=/opt/mousedroid
Environment=COMPOSE_FILE=/opt/mousedroid/docker-compose.jetson.yml

# Optional environment file (dash prefix = no error if missing)
EnvironmentFile=-/etc/mousedroid/docker.env

# Sync production config overlay from repo to /etc/mousedroid (non-fatal).
# systemd requires an absolute executable path in ExecStartPre, so invoke a
# shell and let bash expand MOUSEDROID_INSTALL_DIR inside the command string.
ExecStartPre=-/bin/bash -lc 'exec "${MOUSEDROID_INSTALL_DIR}/scripts/sync_jetson_overlay.sh"'

# Pre-flight validation — abort if required hardware/config is missing
ExecStartPre=/bin/bash -lc 'exec "${MOUSEDROID_INSTALL_DIR}/scripts/preflight_check.sh"'

# Compose file path — default set above, overridable via COMPOSE_FILE in docker.env
# Non-fatal dash prefix: the mousedroid:jetson image is built locally on the
# rover (compose `build:`, no registry), so `pull` always errors — without the
# dash that error aborts every service start.
ExecStartPre=-/usr/bin/docker compose -f ${COMPOSE_FILE} pull --quiet
ExecStart=/usr/bin/docker compose -f ${COMPOSE_FILE} up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f ${COMPOSE_FILE} down --timeout 30

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mousedroid-docker

# Security hardening (compatible with docker socket access)
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
