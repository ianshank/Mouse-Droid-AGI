    {
      "id": 10,
      "title": "Loop Latency Heatmap",
      "description": "Histogram heatmap of control-loop latency distribution (mousedroid_loop_latency_ms histogram). Buckets: 1, 2.5, 5, 10, 20, 33, 50, 100, 200, +Inf ms.",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(mousedroid_loop_latency_ms_bucket[5m])",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "ms"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "tooltip": {
          "show": true
        }
      }
    },
