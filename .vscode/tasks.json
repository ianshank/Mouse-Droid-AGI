{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Training: Phase 0+1 (Local CUDA)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_training_pipeline.ps1",
        "-Config",
        "config/local_training.yaml",
        "-Phases",
        "0,1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Training: Phase 1 Resume (Local CUDA)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_training_pipeline.ps1",
        "-Config",
        "config/local_training.yaml",
        "-Phases",
        "1",
        "-Resume",
        "weights/rssm/epoch_100.pt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Training: Full Pipeline (Local CUDA)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_training_pipeline.ps1",
        "-Config",
        "config/local_training.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}