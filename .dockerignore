# =============================================================================
# MouseDroidAGI — Docker Build Ignore
# =============================================================================
# Excludes unnecessary files from the Docker build context for faster builds.

# Version control
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed at runtime)
docs/
*.md
!README.md

# Tests (installed separately in dev layer)
# tests/

# CI/CD
.github/

# OS files
.DS_Store
Thumbs.db

# Temporary files
/tmp/
*.log

# 3D printing files
docs/3D_printing_files/

# Weights (large model files -- download at runtime)
weights/
models/
*.pt
*.pth
*.onnx
*.tflite
*.gguf
*.bin
*.engine
*.trt
*.plan

# Coverage / test artifacts
.coverage
.coverage.*
coverage.xml
coverage.json
coverage-branch.json
htmlcov/
.pytest_cache/
.benchmarks/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Secrets / env (never bake into an image layer)
.env
.env.local
*.env
secrets.yaml
gcp_credentials/
*.credentials.json

# Host-only runtime artefacts (LMDB experience, reports, training output)
*.mdb
*_experience/
reports/
runs/
checkpoints/

# Claude worktrees + agent workspaces
.claude/
.serena/
.gemini/
