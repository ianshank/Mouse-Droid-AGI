# =============================================================================
# MouseDroid -- CPU-only Development Image
# =============================================================================
# For CI runners and contributors without Jetson hardware.
# Includes full dev toolchain (pytest, ruff, mypy, hypothesis).
#
# Build:  docker build -f Dockerfile.dev -t mousedroid-dev .
# Run:    docker run --rm mousedroid-dev
# Shell:  docker run --rm -it mousedroid-dev bash
# Tests:  docker run --rm mousedroid-dev pytest tests/unit -v
# =============================================================================

FROM python:3.11-slim

LABEL maintainer="Ian Cruickshank"
LABEL description="MouseDroid -- CPU-only dev/CI image (no Jetson hardware)"
LABEL version="0.3.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV MOUSEDROID_MOCK_HARDWARE=true
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies
# ---------------------------------------------------------------------------
WORKDIR /app

# Copy project metadata first for better layer caching.
# README.md is load-bearing, not documentation: pyproject.toml declares
# `readme = "README.md"`, which hatchling resolves during build_wheel, so
# without it the very next `pip install -e .` fails metadata generation.
# Verified by building this exact context with and without it. (LICENSE is
# not strictly required — hatchling tolerates a `license-files` glob that
# matches nothing — but is copied so the built wheel carries it.)
# This broke in #175 (2026-07-24) when `readme =` was added, and stayed
# invisible because the CI docker job runs `docker build --check` — a
# Dockerfile linter that never executes a RUN layer. docker/Dockerfile.cloud
# already carried this COPY; the other two did not.
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/

# Install package with dev extras (CPU-only, no hardware/jetson/arm extras)
RUN pip install --no-cache-dir -e ".[dev,telemetry]"

# Copy remaining project files (tests, configs, scripts)
COPY tests/ ./tests/
COPY config/ ./config/

# ---------------------------------------------------------------------------
# Default: run unit + property tests with a timeout guard
# ---------------------------------------------------------------------------
CMD ["pytest", "tests/unit", "tests/property", "-q", "--timeout=60"]
