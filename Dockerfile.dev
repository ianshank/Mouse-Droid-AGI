# =============================================================================
# MouseDroidAGI — CPU-only Development Image
# =============================================================================
# For CI runners and contributors without Jetson hardware.
# Includes the full dev toolchain (pytest, ruff, mypy, hypothesis).
#
# Build:
#   docker build -f Dockerfile.dev -t mousedroid:dev .
#
# Run tests:
#   docker run --rm mousedroid:dev
#
# Interactive shell:
#   docker run --rm -it mousedroid:dev bash
# =============================================================================

FROM python:3.11-slim AS base

# System dependencies for building native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project metadata + source for dependency resolution
COPY pyproject.toml .
COPY src/ src/

# Non-editable install for better layer caching on source changes
RUN pip install --no-cache-dir ".[dev,telemetry]"

# Copy test suite and configs (changes here don't trigger pip re-install)
COPY tests/ tests/
COPY config/ config/

# Mock hardware for CI
ENV MOUSEDROID_MOCK_HARDWARE=true
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default: run unit + property tests
CMD ["pytest", "tests/unit", "tests/property", "-q", "--timeout=60"]
