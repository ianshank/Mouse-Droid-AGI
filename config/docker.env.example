# =============================================================================
# MouseDroidAGI — Docker Environment Configuration
# =============================================================================
# Copy to /etc/mousedroid/docker.env and edit for your deployment.
# This file is loaded by the mousedroid-docker.service systemd unit.
#
# All variables are optional and have sensible defaults.
# =============================================================================

# --- Application Configuration ---

# Path to the mousedroid YAML config file (inside the container)
# Default: /etc/mousedroid/jetson_production.yaml
MOUSEDROID_CONFIG=/etc/mousedroid/jetson_production.yaml

# Space-separated config overlays passed to `mousedroid.main --config`
# Default: /etc/mousedroid/default.yaml /etc/mousedroid/jetson_production.yaml
# For secure Prometheus scraping, append /etc/mousedroid/jetson_secure_metrics.yaml
MOUSEDROID_CONFIG_FILES="/etc/mousedroid/default.yaml /etc/mousedroid/jetson_production.yaml"

# Enable/disable hardware mocking (set to false for production)
# Default: true (safe for testing)
MOUSEDROID_MOCK_HARDWARE=false

# --- Docker Compose ---

# Path to the docker-compose file used by the systemd service
# Default: /opt/mousedroid/docker-compose.jetson.yml
COMPOSE_FILE=/opt/mousedroid/docker-compose.jetson.yml

# Monitoring stack Prometheus config used by scripts/deploy_monitoring.sh
# Default: ./config/prometheus/scrape_host_gateway.yml
MOUSEDROID_PROMETHEUS_CONFIG=./config/prometheus/scrape_host_gateway.yml

# --- Telemetry ---

# Authentication token for the telemetry REST API
# IMPORTANT: Change this before production deployment!
MOUSEDROID_TELEMETRY_TOKEN=changeme

# Port for the telemetry/health endpoint
# Default: 8080
MOUSEDROID_TELEMETRY_PORT=8080

# Health and metrics paths exposed by the telemetry server
MOUSEDROID_HEALTH_PATH=/api/v1/health
MOUSEDROID_METRICS_PATH=/metrics

# Grafana admin credentials for the monitoring stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-monitoring

# --- Health Check Tuning ---

# Container health check timings (for docker-compose.jetson.yml)
# MOUSEDROID_HEALTH_INTERVAL=15s
# MOUSEDROID_HEALTH_TIMEOUT=5s
# MOUSEDROID_HEALTH_RETRIES=3
# MOUSEDROID_HEALTH_START_PERIOD=30s

# --- Monitoring Stack Image Versions ---

# Pin monitoring container images (for docker-compose.monitoring.yml)
# PROMETHEUS_VERSION=v2.54.1
# LOKI_VERSION=3.2.1
# PROMTAIL_VERSION=3.2.1
# GRAFANA_VERSION=11.2.0
# NODE_EXPORTER_VERSION=v1.8.2

# --- GPU / CUDA ---

# NVIDIA devices visible to the container
# Default: all
NVIDIA_VISIBLE_DEVICES=all

# NVIDIA driver capabilities exposed to the container
# Default: all (compute, utility, graphics, video, display)
NVIDIA_DRIVER_CAPABILITIES=all

# --- Hardware Device Paths ---
# Override if your devices enumerate differently than the defaults.
# Set to empty to skip passthrough for that device.

# ESP32 motor controller UART (default: /dev/ttyUSB0)
MOUSEDROID_ESP32_DEV=/dev/ttyUSB0

# Arducam IMX708 dual CSI — v4l2 media controller node (default: /dev/media0).
# libargus / nvarguscamerasrc is the capture path; no /dev/video* is created.
# For a generic USB webcam, set this to /dev/video0 and update the compose
# mapping to `:/dev/video0` accordingly.
MOUSEDROID_CAMERA_DEV=/dev/media0

# FHL-LD19 LiDAR UART (default: /dev/ttyUSB1)
MOUSEDROID_LIDAR_DEV=/dev/ttyUSB1

# --- Paths ---

# Project install directory on the host (mounted into container)
# Default: /opt/mousedroid
MOUSEDROID_INSTALL_DIR=/opt/mousedroid

# Configuration directory on the host (mounted read-only into container)
# Default: /etc/mousedroid
MOUSEDROID_CONFIG_DIR=/etc/mousedroid
