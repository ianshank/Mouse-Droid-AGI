# =============================================================================
# MouseDroidAGI — Docker Environment Configuration
# =============================================================================
# Copy to /etc/mousedroid/docker.env and edit for your deployment.
# This file is loaded by the mousedroid-docker.service systemd unit.
#
# All variables are optional and have sensible defaults.
# =============================================================================

# --- Application Configuration ---

# Path to the mousedroid YAML config file (inside the container)
# Default: /etc/mousedroid/jetson_production.yaml
MOUSEDROID_CONFIG=/etc/mousedroid/jetson_production.yaml

# Enable/disable hardware mocking (set to false for production)
# Default: true (safe for testing)
MOUSEDROID_MOCK_HARDWARE=false

# --- Docker Compose ---

# Path to the docker-compose file used by the systemd service
# Default: /opt/mousedroid/docker-compose.jetson.yml
COMPOSE_FILE=/opt/mousedroid/docker-compose.jetson.yml

# --- Telemetry ---

# Authentication token for the telemetry REST API
# IMPORTANT: Change this before production deployment!
MOUSEDROID_TELEMETRY_TOKEN=changeme

# Port for the telemetry/health endpoint
# Default: 8080
MOUSEDROID_TELEMETRY_PORT=8080

# --- GPU / CUDA ---

# NVIDIA devices visible to the container
# Default: all
NVIDIA_VISIBLE_DEVICES=all

# NVIDIA driver capabilities exposed to the container
# Default: all (compute, utility, graphics, video, display)
NVIDIA_DRIVER_CAPABILITIES=all

# --- Hardware Devices ---
# Device paths passed through to the Docker container.
# Required: ESP32 (motor), Camera (vision), GPIO (ultrasonic)
# Optional: LiDAR, Audio (speaker/mic)

# ESP32 UART serial port (required for motor control)
# Default: /dev/ttyUSB0
MOUSEDROID_ESP32_DEV=/dev/ttyUSB0

# Camera device (required for vision pipeline)
# Default: /dev/video0
MOUSEDROID_CAMERA_DEV=/dev/video0

# LiDAR UART serial port (optional — comment out if no LiDAR)
# Default: /dev/ttyUSB1
MOUSEDROID_LIDAR_DEV=/dev/ttyUSB1

# --- Paths ---

# Project install directory on the host (mounted into container)
# Default: /opt/mousedroid
MOUSEDROID_INSTALL_DIR=/opt/mousedroid

# Configuration directory on the host (mounted read-only into container)
# Default: /etc/mousedroid
MOUSEDROID_CONFIG_DIR=/etc/mousedroid
