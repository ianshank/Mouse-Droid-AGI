# =============================================================================
# MouseDroid — Docker Environment Configuration
# =============================================================================
# Copy to /etc/mousedroid/docker.env and edit for your deployment.
# This file is loaded by the mousedroid-docker.service systemd unit.
#
# All variables are optional and have sensible defaults.
# =============================================================================

# --- Application Configuration ---

# Path to the mousedroid YAML config file (inside the container)
# Default: /etc/mousedroid/jetson_production.yaml
MOUSEDROID_CONFIG=/etc/mousedroid/jetson_production.yaml

# Enable/disable hardware mocking (set to false for production)
# Default: true (safe for testing)
MOUSEDROID_MOCK_HARDWARE=false

# --- Docker Compose ---

# Path to the docker-compose file used by the systemd service
# Default: /opt/mousedroid/docker-compose.jetson.yml
COMPOSE_FILE=/opt/mousedroid/docker-compose.jetson.yml

# --- Telemetry ---

# Authentication token for the telemetry REST API.
# IMPORTANT: Set this before production deployment — auth fails closed, so an
# empty token 401s every non-exempt request. Generate one with:
#   openssl rand -hex 32
# The deploy sequence presence-checks this value (never echoes it). The key
# stays UNCOMMENTED here (empty value) on purpose: the host_env_keys preflight
# check parses this template's key set, and host_bootstrap.sh seeds fresh
# hosts from it — a commented line would silently drop it from both.
MOUSEDROID_TELEMETRY_TOKEN=

# Where the operator PROBE scripts look for the telemetry endpoint
# (scripts/jetson_probe_*.py, jetson_new_features_probe.sh). It does NOT move
# the rover: it is not a settings key, because the nested delimiter is `__`.
# The rover serves telemetry.port from its YAML, overridable with the
# MOUSEDROID_TELEMETRY__PORT line below. docker_deploy.sh ignores this value
# whenever it can read the port the running rover resolved, and warns if the
# two disagree. Kept uncommented because the probe scripts read it.
# Default: 8080
MOUSEDROID_TELEMETRY_PORT=8080

# The key that actually moves the rover's telemetry port (env overrides YAML).
# Left COMMENTED on purpose, like MOUSEDROID_JETSON__TENSORRT_CACHE_DIR below:
# the host_env_keys preflight check warns on any UNcommented template key a
# provisioned rover lacks, and the YAML default is already correct.
# MOUSEDROID_TELEMETRY__PORT=8080

# --- GPU / CUDA ---

# NVIDIA devices visible to the container
# Default: all
NVIDIA_VISIBLE_DEVICES=all

# NVIDIA driver capabilities exposed to the container
# Default: all (compute, utility, graphics, video, display)
NVIDIA_DRIVER_CAPABILITIES=all

# --- Hardware Devices ---
# Device paths passed through to the Docker container.
# Required: ESP32 (motor), Camera (vision), GPIO (ultrasonic)
# Optional: LiDAR, Audio (speaker/mic)

# ESP32 UART serial port (required for motor control)
# Default: /dev/ttyUSB0
MOUSEDROID_ESP32_DEV=/dev/ttyUSB0

# ESP32 driver enable — repair lever for the F-008 bring-up.
# config/jetson_production.yaml ships esp32.enabled: false (dead-board
# safe default). After a bench repair passes the probe-first bring-up
# (docs/runbooks/jetson-full-bringup.md), uncomment to go live — env
# overrides YAML, no commit needed. Leave commented while the board is dead.
# MOUSEDROID_ESP32__ENABLED=true

# ESP32 firmware command set (F-025). Stock Waveshare General_Driver
# firmware ignores the legacy private protocol (motion parses as zeros;
# the legacy battery poll is a motor-PID WRITE). Uncomment when the board
# runs stock firmware — also derives serial_baud=115200 unless pinned.
# This env lever is the ONLY opt-in path until deployments/jetson-image.json
# is re-pinned to a schema that knows the field (config-compat gate).
# MOUSEDROID_ESP32__COMMAND_SET=waveshare_stock

# Camera device (required for vision pipeline)
# Default: /dev/video0
MOUSEDROID_CAMERA_DEV=/dev/video0

# LiDAR UART serial port (optional — comment out if no LiDAR)
# Default: /dev/ttyUSB1
MOUSEDROID_LIDAR_DEV=/dev/ttyUSB1

# SSD1306 OLED face-display I²C device (optional — comment out if no panel)
# Jetson Orin Nano header I²C is bus 7 → /dev/i2c-7
# Default: /dev/i2c-7
MOUSEDROID_FACE_DISPLAY_DEV=/dev/i2c-7

# Real-hardware smoke test gate for the SSD1306 face panel.
# Set to 1 only on a Jetson with the panel attached so that
# `pytest -m hardware tests/hardware/test_ssd1306_smoke.py` will run.
# Default: 0 (skipped)
MOUSEDROID_FACE_DISPLAY_SMOKE=0

# --- Paths ---

# Project install directory on the host (mounted into container)
# Default: /opt/mousedroid
MOUSEDROID_INSTALL_DIR=/opt/mousedroid

# Destination path for the Jetson production config overlay on the host.
# The overlay is auto-synced from ${MOUSEDROID_INSTALL_DIR}/config/jetson_production.yaml
# at service start by scripts/sync_jetson_overlay.sh (non-fatal ExecStartPre step).
# Default: /etc/mousedroid/jetson_production.yaml
MOUSEDROID_OVERLAY_DST=/etc/mousedroid/jetson_production.yaml

# Configuration directory on the host (mounted read-only into container)
# Default: /etc/mousedroid
MOUSEDROID_CONFIG_DIR=/etc/mousedroid

# TensorRT engine/timing cache directory INSIDE the container. One key, two
# consumers: pydantic-settings reads it as cfg.jetson.tensorrt_cache_dir, and
# docker-compose.jetson.yml interpolates the same name as the mount point of
# the named volume `mousedroid_tensorrt_cache`, so the cache location can never
# drift between the mount and the Python config.
# Default: /opt/mousedroid/tensorrt_cache (the JetsonConfig schema default)
#
# Left COMMENTED on purpose. The preflight `host_env_keys` check compares this
# template's key NAMES against the deployed /etc/mousedroid/docker.env and warns
# on any the rover is missing; an uncommented key would make every already
# provisioned rover warn until host_bootstrap.sh is re-run, for a value that is
# already correct by default. Uncomment only to relocate the cache.
#
# Where it may go: an absolute path of [A-Za-z0-9._/-], not a top-level
# directory, not inside an OS-image tree (/etc, /usr, /run, ... or /var/run,
# /var/lock), and neither covering nor inside another of the service's mounts
# or /opt/mousedroid/src and /opt/mousedroid/weights. Anything else is refused
# before compose runs -- by docker_deploy.sh, and at boot by the unit's
# preflight, which then does not start. Rules: scripts/validate_compose_env.sh.
# MOUSEDROID_JETSON__TENSORRT_CACHE_DIR=/opt/mousedroid/tensorrt_cache

# ---------------------------------------------------------------------------
# Claude (Anthropic) cloud LLM tier — PR #107
# ---------------------------------------------------------------------------
# Provide ONE of these to enable the cloud mission-translation tier. NEVER
# commit a real key. The Anthropic SDK reads ANTHROPIC_API_KEY natively; the
# schema-mapped override below is SecretStr-wrapped and kept out of YAML.
# When neither is set, the gateway degrades to the local Phi-3 fallback.
# ANTHROPIC_API_KEY=sk-ant-...
# MOUSEDROID_LLM__API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# LLM gateway host overrides — F-017 (survive reflash via host_bootstrap.sh)
# ---------------------------------------------------------------------------
# These per-host overrides previously lived ONLY on the Jetson and were lost
# on every reflash/rover swap. They are enumerated here so the host_env_keys
# preflight check can WARN when a deployed docker.env is missing them.

# Enable the LLM gateway (cloud Claude primary + local GGUF fallback)
# Default: true
MOUSEDROID_LLM__ENABLED=true

# GPU layers offloaded by the local GGUF fallback (0 = CPU-only)
# Default: 0 (CPU fallback on the 8 GB Orin - the world model owns the iGPU)
MOUSEDROID_LLM__N_GPU_LAYERS=0

# ---------------------------------------------------------------------------
# scripts/docker_deploy.sh knobs (F-052 task 5.5)
# ---------------------------------------------------------------------------
# docker_deploy.sh loads this file before reading these, so they can be set
# here. All are COMMENTED on purpose: the defaults are correct, and the
# host_env_keys preflight check would otherwise warn on every rover that lacks
# them. Deliberately NOT listed, because setting them HERE would not work:
#   MOUSEDROID_CONTAINER      compose hardcodes `container_name: mousedroid`;
#                             a different value sends the health check looking
#                             for a container that does not exist.
#   MOUSEDROID_COMPOSE_FILE   the systemd unit uses COMPOSE_FILE (above), so
#                             this would split the deploy script from boot.
#   MOUSEDROID_DOCKER_ENV_FILE  the path OF this file; it is read before this
#                             file is loaded, so setting it here is circular.
#   MOUSEDROID_REMOTE_*, MOUSEDROID_DEPLOY_ARCHIVE_DIR, MOUSEDROID_DEPLOY_CONFIRM_DIRTY,
#   MOUSEDROID_ROVER_WIP_*    read by scripts/deploy_remote.sh, which runs on
#                             the operator's PC and never reads this file.

# Override the port/path the deploy health check probes. Unset (the default),
# both are read from the RUNNING rover's own resolved config, so they follow
# telemetry.port and telemetry.api_prefix automatically.
# MOUSEDROID_HEALTH_PORT=8080
# MOUSEDROID_HEALTH_PATH=/api/v1/health

# Seconds to wait for the container to reach `running` before failing.
# MOUSEDROID_HEALTH_TIMEOUT=30

# 1/true makes every deploy a promotion gate (same as --strict-health).
# MOUSEDROID_STRICT_HEALTH=0

# Deploy record holding the expected model digest. Read INSIDE the container,
# so it must live under the /opt/mousedroid bind mount.
# MOUSEDROID_DEPLOY_RECORD=/opt/mousedroid/deployments/jetson-image.json
