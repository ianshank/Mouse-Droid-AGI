# Operator template — copy to /etc/mousedroid/docker.env on each Jetson.
#
# docker-compose.jetson.yml loads this file via:
#   env_file:
#     - path: /etc/mousedroid/docker.env
#       required: false
# and passes every key into the orchestrator container's environment.
#
# **Compose precedence:** the inline ``environment:`` block in the compose
# file ALWAYS overrides values defined here. The compose file deliberately
# keeps secrets (TELEMETRY_TOKEN) and per-host tunables (MOCK_HARDWARE,
# LLM__N_GPU_LAYERS, etc.) OUT of its inline block so this file is the
# single source of truth for them.
#
# Production defaults: real hardware mode, telemetry auth on with a per-host
# token. Override per-host as needed.

# Mock-hardware mode. ``false`` (production) wires real CSI camera / LiDAR /
# ESP32 / microphone / speaker. ``true`` (dev) builds mocks for every driver.
# This value reaches the container directly via env_file — no compose
# interpolation in the way (see Copilot review of PR #101 for the bug this
# replaces).
MOUSEDROID_MOCK_HARDWARE=false

# Telemetry server auth. Required when ``telemetry.auth.auth_enabled: true``
# in jetson_production.yaml (the default). Generate a per-host token (32+
# bytes random base64 is fine) and rotate on every operator change.
MOUSEDROID_TELEMETRY_TOKEN=changeme-generate-a-real-token-per-host

# --- Optional per-host overrides ---

# Pin GPU offload for the LLM gateway. ``-1`` (default in
# config/jetson_production.yaml) offloads every layer to the iGPU. Set ``=0``
# on a CPU-only fallback host without flipping any committed file (see F-006).
# Nested-env precedence (MOUSEDROID_SECTION__FIELD) is honoured by the
# loader's nested env-strip — this value overrides the YAML overlay.
# MOUSEDROID_LLM__N_GPU_LAYERS=-1

# GCP digital twin (optional — only set if cloud sync is enabled). The compose
# inline ``environment:`` deliberately omits GCP_PROJECT_ID because an empty
# string fails Pydantic validation; set the project id here or leave unset.
# GCP_PROJECT_ID=mousedroid-prod
# GCP_CREDENTIALS_FILE=/etc/mousedroid/gcp-credentials.json

# --- F-006 follow-up (path c): route LLM off-Jetson to host-PC Ollama ---
# Uncomment + populate when deploying with config/jetson_production_remote_llm.yaml.
# See docs/operator/JETSON_REMOTE_LLM_SETUP.md for the full setup (Ollama install,
# host-PC IP discovery, runbook). The compose env_file (PR #101 F-014 fix) reads
# this file directly so the four vars below reach the container without any
# host-shell export gymnastics.
# MOUSEDROID_LLM__BACKEND=openai_compatible
# MOUSEDROID_LLM__BASE_URL=http://192.168.55.100:11434
# MOUSEDROID_LLM__MODEL_NAME=phi3:mini
# MOUSEDROID_LLM__API_KEY=changeme-rotate-per-host
