# Operator template — copy to /etc/mousedroid/docker.env on each Jetson.
#
# docker-compose.jetson.yml reads /etc/mousedroid/docker.env via env_file and
# passes every key into the orchestrator container's environment. The inline
# ``environment:`` block in the compose file only carries values that must be
# host-shell-resolved (NVIDIA caps, GCP credentials) — everything else lives
# here.
#
# Production defaults: real hardware mode, telemetry auth on with a per-host
# token. Override per-host as needed.

# Mock-hardware mode. ``false`` (production) wires real CSI camera / LiDAR /
# ESP32 / microphone / speaker. ``true`` (dev) builds mocks for every driver.
# Smoke-stability sprint findings F-012 / F-014 documented that the previous
# default (``:-true`` in the compose interpolation) silently overrode this
# file — that's now fixed so this value is honoured.
MOUSEDROID_MOCK_HARDWARE=false

# Telemetry server auth. Required when ``telemetry.auth.auth_enabled: true``
# in jetson_production.yaml (the default). Generate a per-host token (32+
# bytes random base64 is fine) and rotate on every operator change.
MOUSEDROID_TELEMETRY_TOKEN=changeme-generate-a-real-token-per-host

# --- Optional per-host overrides ---

# Pin GPU offload for the LLM gateway. ``-1`` (default in
# config/jetson_production.yaml) offloads every layer to the iGPU. Set ``=0``
# on a CPU-only fallback host without flipping any committed file (see F-006).
# MOUSEDROID_LLM__N_GPU_LAYERS=-1

# GCP digital twin (optional — only set if cloud sync is enabled). The compose
# inline ``environment:`` deliberately omits GCP_PROJECT_ID because an empty
# string fails Pydantic validation; set the project id here or leave unset.
# GCP_PROJECT_ID=mousedroid-prod
# GCP_CREDENTIALS_FILE=/etc/mousedroid/gcp-credentials.json
