# Scratch directory at the repo root, if a tool ever materialises one.
#
# This replaces five patterns that could never fire: /tmp/jetson_*.py,
# /tmp/install_*.py, /tmp/mousedroid_heartbeat, /tmp/wave_rover_* and
# /tmp/*.html were written for the SYSTEM /tmp, but a leading slash in
# .gitignore anchors to the REPOSITORY root, so they only ever described
# <repo>/tmp/. git cannot ignore paths outside the worktree at all — nothing
# under the system /tmp is ever a candidate for staging, so those entries were
# inert rather than protective. Keep the one case the syntax can express.
/tmp/

# Host-specific Docker Compose overrides (generated when device nodes
# are transiently missing; do not commit — regenerate per host).
docker-compose.override.yml
docker-compose.override.yaml

