# =============================================================================
# MouseDroid — Jetson L4T PyTorch Container
# =============================================================================
# Base: dustynv/l4t-pytorch with CUDA 12.6, cuDNN, TensorRT pre-installed
# Target: Jetson Orin Nano, JetPack 6.x (L4T R36.4)
#
# Build:  docker compose -f docker-compose.jetson.yml build
# Run:    docker compose -f docker-compose.jetson.yml up -d
# Shell:  docker exec -it mousedroid bash
# =============================================================================

FROM dustynv/llama_cpp:r36.4.0 AS llm_builder

FROM dustynv/l4t-pytorch:r36.4.0

LABEL maintainer="Ian Cruickshank"
LABEL description="MouseDroid — GPU-accelerated runtime on Jetson Orin Nano"
LABEL version="0.3.0"

ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Fix pip index: L4T base uses jetson.webredirect.org which may not
# resolve. Override to use standard PyPI with NVIDIA as extra index.
# ---------------------------------------------------------------------------
ENV PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_EXTRA_INDEX_URL=https://pypi.ngc.nvidia.com
ENV PIP_TRUSTED_HOST="pypi.org pypi.ngc.nvidia.com"

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    libgpiod-dev \
    v4l-utils \
    i2c-tools \
    libcap-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Stage 1: Core mousedroid package
# ---------------------------------------------------------------------------
WORKDIR /opt/mousedroid

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/

RUN pip install --no-cache-dir typing_extensions>=4.0 && \
    pip install --no-cache-dir -e "."

# ---------------------------------------------------------------------------
# Stage 2: Hardware extras (non-fatal — graceful fallback)
# These require Jetson-specific system libraries; log warnings on failure.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir pyserial>=3.5 python-prctl 2>&1 \
    || echo "WARNING: pyserial/prctl install failed (non-fatal on non-Jetson)"
# CfC liquid neural network (dual-stream world model — non-fatal)
RUN pip install --no-cache-dir "ncps>=0.0.7" 2>&1 \
    || echo "WARNING: ncps install failed (dual-stream CfC disabled)"
RUN pip install --no-cache-dir Jetson.GPIO>=2.1 2>&1 \
    || echo "WARNING: Jetson.GPIO install failed (expected on non-Jetson hosts)"
# picamera2 may fail without libcamera system libs — graceful skip
RUN pip install --no-cache-dir picamera2 2>&1 \
    || echo "WARNING: picamera2 install failed (requires libcamera system libs)"

# Telemetry + service discovery + audio processing (non-fatal)
RUN apt-get update && apt-get install -y --no-install-recommends portaudio19-dev \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: portaudio19-dev install failed (pyaudio will be unavailable)"
RUN pip install --no-cache-dir "aiohttp>=3.9" "zeroconf>=0.80" 2>&1 \
    || echo "WARNING: aiohttp/zeroconf install failed (telemetry server degraded)"
RUN pip install --no-cache-dir pyaudio 2>&1 \
    || echo "WARNING: pyaudio install failed (audio capture disabled)"

# SSD1306 OLED face display dependencies (I²C). Pinned via [hardware] extra in
# pyproject.toml; install explicitly here so the production image has them
# even though the base `pip install -e "."` only resolves required deps.
RUN pip install --no-cache-dir "smbus2>=0.4" "luma.oled>=3.12" "Pillow>=10.0" 2>&1 \
    || echo "WARNING: SSD1306 OLED deps install failed (face display disabled)"

# ---------------------------------------------------------------------------
# Stage 3: Dev tools (pytest, ruff, mypy, coverage)
# Default TRUE, matching docker-compose.jetson.yml's build-arg default — this
# rover is a validation platform (Pattern-B pillar checks + in-container ci.sh
# need pytest). Pass INSTALL_DEV_TOOLS=false explicitly for a lean image.
# ---------------------------------------------------------------------------
ARG INSTALL_DEV_TOOLS=true
RUN if [ "$INSTALL_DEV_TOOLS" = "true" ]; then \
    pip install --no-cache-dir \
        "pytest>=7.0" \
        "pytest-asyncio>=0.21" \
        "pytest-cov>=4.0" \
        "pytest-timeout>=2.3" \
        "pytest-xdist>=3.0" \
        "hypothesis>=6.80" \
        "ruff>=0.4" \
        "mypy>=1.5" \
        "pip-audit" ; \
    else \
        echo "Skipping dev tools (INSTALL_DEV_TOOLS=$INSTALL_DEV_TOOLS)" ; \
    fi

# ---------------------------------------------------------------------------
# Stage 4: LLM gateway dependencies (Multi-Stage Extraction)
# NOTE: Bypasses 8GB OOM issues by pulling pre-compiled Jetson wheels/libs
#       directly from the dustynv/llama_cpp substrate image.
# ---------------------------------------------------------------------------
COPY --from=llm_builder /usr/local/lib/python3.10/dist-packages/llama_cpp /usr/local/lib/python3.10/dist-packages/llama_cpp
COPY --from=llm_builder /usr/local/lib/python3.10/dist-packages/llama_cpp_python-*.dist-info /usr/local/lib/python3.10/dist-packages/

RUN pip install --no-cache-dir "huggingface-hub>=0.20" diskcache || true

# ---------------------------------------------------------------------------
# Stage 4b: Anthropic Claude SDK (cloud LLM tier — PR #107) — non-fatal.
# PR #107's gateway degrades to the local llama_cpp tier when this is absent,
# so a failed install must NOT break the build (matches the hardware/GCP
# layer policy). Pure-Python wheel — no native build, no OOM risk.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir "anthropic>=0.40" \
    || echo "WARNING: anthropic install failed (cloud Claude tier disabled; local fallback only)"

# ---------------------------------------------------------------------------
# Stage 5: Hailo-8 accelerator support (non-fatal — graceful fallback)
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir "hailort>=4.18" || true

# ---------------------------------------------------------------------------
# Stage 5b: Rocky voice (Piper TTS) — non-fatal
#
# /opt/mousedroid is bind-mounted from the host in docker-compose.jetson.yml,
# so the voice model is staged at /opt/voice_models to avoid being masked at
# runtime. The path here MUST match voice.tts_model_path in the runtime YAML
# (config/jetson_production.yaml).
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir "piper-tts" 2>&1 \
    || echo "WARNING: piper-tts install failed (Rocky voice disabled)"
RUN mkdir -p /opt/voice_models && \
    curl -fsSL --retry 3 --retry-delay 2 \
        -o /opt/voice_models/en_US-lessac-medium.onnx \
        https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx && \
    curl -fsSL --retry 3 --retry-delay 2 \
        -o /opt/voice_models/en_US-lessac-medium.onnx.json \
        https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json \
    || echo "WARNING: piper voice model download failed (Rocky voice disabled until model staged)"

# ---------------------------------------------------------------------------
# Stage 6: GCP Digital Twin (non-fatal — graceful fallback)
# Cloud telemetry, experience export, and training pipeline integration.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    "google-cloud-pubsub>=2.18" \
    "google-cloud-storage>=2.10" \
    "google-cloud-logging>=3.5" \
    "google-cloud-monitoring>=2.16" \
    "google-auth>=2.20" \
    || echo "WARNING: GCP SDK install failed (cloud features disabled)"

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# PYTHONOPTIMIZE=1 is the documented Jetson runtime contract (CLAUDE.md /
# AGENTS.md): the codebase is hardened for -O (explicit `is None` checks,
# raise-not-assert in validation paths). This ENV makes the image match the
# docs. Operator-overridable (`-e PYTHONOPTIMIZE=0`) for debugging; the
# jetson_full_validation.sh in-container ci.sh step overrides it to 0 so the
# pytest suite keeps assert semantics.
ENV PYTHONOPTIMIZE=1
ENV MOUSEDROID_CONFIG=/etc/mousedroid/default.yaml
ENV MOUSEDROID_MOCK_HARDWARE=false
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

# Healthcheck + entrypoint helpers. The entrypoint script derives
# Settings-driven env vars (heartbeat path, staleness threshold, grace
# window) and writes them to /run/mousedroid.env before execing the main
# process. The healthcheck script reads that env file and stat's the
# heartbeat file touched by the orchestrator's tick loop
# (orchestrator.py:1017 calls watchdog.notify()). True liveness probe —
# observes the running process, no Python startup, no resource
# contention. See scripts/mousedroid_healthcheck.sh and
# src/mousedroid/health/healthcheck_env.py for the wiring.
COPY scripts/mousedroid_entrypoint.sh scripts/mousedroid_healthcheck.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/mousedroid_entrypoint.sh \
              /usr/local/bin/mousedroid_healthcheck.sh

# start-period is small (10s) because the healthcheck script has its own
# grace logic driven by cfg.loop.start_grace_s. Docker's grace becomes a
# safety net for "process didn't even reach the entrypoint" cases.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD /usr/local/bin/mousedroid_healthcheck.sh

ENTRYPOINT ["/usr/local/bin/mousedroid_entrypoint.sh"]
CMD ["--config", "/etc/mousedroid/default.yaml"]
